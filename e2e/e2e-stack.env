# =============================================================================
# Disposable env for the auth-flows E2E docker stack.  SAFE TO COMMIT.
#
# Every value here is a THROWAWAY, NON-SECRET test fixture for a stack that is
# created fresh and torn down with `down -v` on every run (run-auth-flows.sh).
# Nothing here is, or may be used as, a real credential. Values are intentionally
# all-lowercase fixture strings (see scripts/check-no-secrets.mjs).
#
# Deliberately NOT named `.env.e2e` — `.env.*` is a gitignored secret catch-all
# in this repo. This file must be tracked so CI can use it.
# =============================================================================

# --- nginx host ports for the isolated stack (task references :8083) ---
HTTP_PORT=8083
HTTPS_PORT=8444
NGINX_CONFIG=nginx.conf

# --- build tag (never pushed; see CLAUDE.md "local-" convention) ---
HELIOS_VERSION=local-e2e

# --- database ---
DB_NAME=helios
DB_USER=postgres
DB_PASSWORD=e2e_postgres_password
REDIS_PASSWORD=

# --- required secrets (production env-validation wants >= 32 chars) ---
JWT_SECRET=e2e_jwt_secret_not_for_production_0123456789abcdef
ENCRYPTION_KEY=e2e_encryption_key_not_for_production_0123456789
EMAIL_ENCRYPTION_KEY=e2e_email_encryption_key_not_for_production_0123456789

# --- object storage (minio) ---
S3_ACCESS_KEY=e2e_minio_access_key
S3_SECRET_KEY=e2e_minio_secret_key_1234567

# --- URLs / origins ---
# CRITICAL: better-auth rejects sign-in from an untrusted Origin with 403
# INVALID_ORIGIN. The backend adds FRONTEND_URL to its trusted-origins set (and
# the loopback-alias logic then also trusts 127.0.0.1 / [::1] on the same port),
# so this MUST match the URL the browser loads (BASE_URL in the Playwright config).
FRONTEND_URL=http://localhost:8083
PUBLIC_URL=http://localhost:8083
VITE_DEFAULT_THEME=helios-purple

# --- first-run behaviour ---
# DEFAULT_ADMIN_EMAIL / DEFAULT_ADMIN_PASSWORD are intentionally OMITTED. With
# them unset, backend seedDefaultAdmin() does NOT auto-create an org/admin, so a
# fresh stack serves the setup wizard — which is exactly what these tests cover.
