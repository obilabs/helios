# Production Dockerfile for Helios Client Backend
# Multi-stage build: Build TypeScript, then run with minimal image

# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies (@obilabs/licensing from GitHub Packages via NPM_TOKEN secret)
COPY package*.json .npmrc ./
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN="$(cat /run/secrets/npm_token)" npm ci

# Copy source and build
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy package files and install production deps only (@obilabs/licensing needs the
# same GitHub Packages auth; NPM_TOKEN via BuildKit secret, never baked in)
COPY package*.json .npmrc ./
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN="$(cat /run/secrets/npm_token)" npm ci --omit=dev && npm cache clean --force

# Copy built application from builder
COPY --from=builder /app/dist ./dist

# Create logs directory
RUN mkdir -p /app/logs

# Create database directory for schema file
RUN mkdir -p /app/database

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

# Run as node user (already exists in node:alpine)
USER node

CMD ["node", "dist/index.js"]
