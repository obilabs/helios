# @obilabs/* scoped packages resolve from GitHub Packages (same as the aegis repo).
# The auth token is NOT committed — it is supplied out-of-band as the NPM_TOKEN
# env var (npm substitutes ${NPM_TOKEN} at install time). In Docker it is injected
# via a BuildKit secret mount, never baked into an image layer. Locally, export
# NPM_TOKEN (a PAT with read:packages) before `npm install`.
@obilabs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
