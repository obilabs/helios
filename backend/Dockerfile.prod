# Production Dockerfile for Helios Client Backend
# Multi-stage build: Build TypeScript, then run with minimal image

# Build stage
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

WORKDIR /app

# Install dependencies (@obilabs/licensing is public on npmjs — no token)
COPY package*.json ./
RUN npm ci

# Copy source and build
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

# Production stage
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy package files and install production deps only (@obilabs/licensing is
# public on npmjs — no token, no BuildKit secret)
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy built application from builder
COPY --from=builder /app/dist ./dist

# Ship the incremental SQL migrations into the image so the boot-time runner
# (dist/database/migrate.js) can find them at /app/database/migrations. The base
# schema_organization.sql is still bind-mounted here at runtime by docker-compose.
COPY database ./database

# Create logs directory — owned by the non-root `node` user that runs the process
# (USER node below), otherwise winston's File transport silently fails to write.
RUN mkdir -p /app/logs /app/data && chown -R node:node /app/logs /app/data

# Ensure the database directory exists (schema file is mounted here at runtime)
RUN mkdir -p /app/database

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

# The published image ships the release profile: only stable features on.
# docker-compose.dev.yml and the E2E stack override this with `development`.
ENV HELIOS_FEATURE_PROFILE=release

# Run as node user (already exists in node:alpine)
USER node

CMD ["node", "dist/index.js"]
