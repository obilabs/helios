# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables.
#
# `.env.*` is a CATCH-ALL on purpose. The previous form enumerated three names
# (.local/.production/.development), which meant any name nobody thought of —
# .env.staging, .env.test, .env.e2e — was stageable by a plain `git add -A`
# with nothing throwing. An allowlist of secret filenames is the wrong shape:
# it fails open on every name you forget. The committed templates are the
# explicit negations below.
.env
.env.*
!.env.example
!env.example

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
*.lcov
.nyc_output

# Docker
docker-compose.override.yml

