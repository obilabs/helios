token.txt
*.token
# Test artifacts
test-results/
playwright-report/
**/test-results/
**/playwright-report/
# auth-flows E2E HTML report (CI reporter output)
e2e/playwright-report-auth-flows/

# Reference screenshots (for design discussions)
e2e/reference-screenshots/

# Secrets
.secrets/
backend/.secrets/

# Local-only notes. The `.local.md` suffix is the marker for a file that holds
# working credentials / environment logins and must never be committed —
# see LOCAL-TEST-ENV.local.md, which deliberately lives outside any repo.
*.local.md

# Static test credentials, at any depth. `openspec/testing/TEST-CREDENTIALS.md`
# was committed on 2026-07-27 carrying an email, a plaintext password and its
# bcrypt hash, and it is still present on every branch. The durable fix is a
# seed script that GENERATES credentials and prints them, so no static file
# exists to leak; this pattern stops the shape from coming back meanwhile.
**/TEST-CREDENTIALS.md
**/TEST_CREDENTIALS.md

# Separate projects (have their own repos)
projects/

# R&D session logs (grant documentation — kept locally, not committed)
.rd_log/



# Generated test reports/screenshots (build output — never commit)
openspec/testing/reports/

# Raw M365 Graph write recordings — scrub before copying into __tests__/fixtures
.record-fixtures/
